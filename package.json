{
  "name": "arcveil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm packages:build && next dev",
    "build": "pnpm packages:build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm packages:build && vitest run --passWithNoTests && pnpm --filter @arcveildev/sdk test && pnpm --filter @arcveil/bridge test && pnpm --filter @arcveil/relay test && pnpm --filter @arcveil/gate test && pnpm --filter @arcveil/imessage test && pnpm --filter @arcveil/onramp test",
    "test:watch": "vitest",
    "gen:receipts": "tsx scripts/gen-receipts.mts",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "gate:corpus": "tsx scripts/gate-corpus.mts",
    "gate:bench": "tsx scripts/gate-bench.mts",
    "gate:tune": "tsx scripts/gate-tune.mts",
    "gate:deploy": "pnpm --filter @arcveil/gate deploy",
    "gate:dev": "pnpm --filter @arcveil/gate dev",
    "sdk:build": "pnpm --filter @arcveildev/sdk build",
    "typecheck": "tsc --noEmit --incremental false && pnpm --filter @arcveildev/sdk typecheck && pnpm --filter @arcveil/bridge typecheck && pnpm --filter @arcveil/relay typecheck && pnpm --filter @arcveil/gate typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "intent": "tsx scripts/intent.mts",
    "film:studio": "pnpm --filter @arcveil/film studio",
    "film:render": "pnpm --filter @arcveil/film render ../../docs/social/video/docs/arcveil-docs.mp4",
    "bridge:build": "pnpm --filter @arcveil/bridge build",
    "packages:build": "pnpm sdk:build && pnpm bridge:build",
    "relay:deploy": "pnpm --filter @arcveil/relay deploy",
    "relay:dev": "pnpm --filter @arcveil/relay dev",
    "veil:artifacts": "tsx scripts/veil-artifacts.mts",
    "veil:addresses": "tsx scripts/veil-addresses.mts"
  },
  "dependencies": {
    "@arcveil/bridge": "workspace:*",
    "@arcveildev/sdk": "workspace:*",
    "@circle-fin/onramp-kit": "1.0.1",
    "@tanstack/react-query": "^5.103.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "snarkjs": "0.7.5",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.56.5",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/snarkjs": "0.7.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.2",
    "zod": "^4.6.2"
  },
  "packageManager": "pnpm@11.9.0"
}
